# Local MySQL connection used by `npm run dev`.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=job_site_db
DB_USER=root
DB_PASSWORD=

# Replace this value before deploying.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

PORT=5000
NODE_ENV=development
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880
